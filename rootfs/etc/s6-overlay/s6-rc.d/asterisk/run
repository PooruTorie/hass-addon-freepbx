#!/usr/bin/with-contenv bashio
set -euo pipefail

bashio::log.info "Starte Asterisk (s6-rc)..."

/usr/sbin/asterisk -f -U asterisk -G asterisk &
ASTERISK_PID=$!

# Readiness: warte auf CLI
READY=0
for _i in $(seq 1 120); do
  if asterisk -rx 'core show uptime' >/dev/null 2>&1; then
    bashio::log.info "Asterisk ready."
    echo "ready" >&3
    READY=1
    break
  fi
  sleep 1
  if ! kill -0 "$ASTERISK_PID" 2>/dev/null; then
    bashio::log.error "Asterisk ist vor Readiness beendet."
    wait "$ASTERISK_PID" || true
    exit 1
  fi
done

if [ "$READY" -ne 1 ]; then
  bashio::log.error "Asterisk wurde innerhalb des Timeouts nicht ready."
  kill "$ASTERISK_PID" 2>/dev/null || true
  wait "$ASTERISK_PID" || true
  exit 1
fi

wait "$ASTERISK_PID"
