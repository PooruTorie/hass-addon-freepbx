#!/usr/bin/with-contenv bashio
set -euo pipefail

bashio::log.info "=== MariaDB Pre-Start ==="

DATADIR="/data/mariadb"
LEGACY_DATADIR="/var/lib/mysql"

mkdir -p /var/run/mysqld "${DATADIR}"
chown -R mysql:mysql /var/run/mysqld "${DATADIR}"
chmod 750 "${DATADIR}" || true

# Wenn ein Legacy-Datadir existiert (z.B. aus dem Image-Build oder alten Containern),
# migrieren wir es einmalig nach /share.
if [ -d "${LEGACY_DATADIR}" ] && [ ! -L "${LEGACY_DATADIR}" ]; then
  if [ ! -d "${DATADIR}/mysql" ] && [ -e "${LEGACY_DATADIR}/mysql" -o -e "${LEGACY_DATADIR}/ibdata1" ]; then
    bashio::log.info "MariaDB: migriere bestehende Daten von ${LEGACY_DATADIR} nach ${DATADIR} ..."
    # rsync ist nicht garantiert installiert; cp -a ist hier ausreichend.
    cp -a "${LEGACY_DATADIR}/." "${DATADIR}/" || true
    chown -R mysql:mysql "${DATADIR}"
  fi
fi

# Kompatibilität: viele Tools erwarten /var/lib/mysql. Symlink macht das transparent.
# (Wenn /var/lib/mysql schon ein Verzeichnis mit Inhalt ist, lassen wir es bestehen,
#  aber der mysqld wird trotzdem mit --datadir gestartet.)
if [ -d "${LEGACY_DATADIR}" ] && [ ! -L "${LEGACY_DATADIR}" ]; then
  if [ -z "$(ls -A "${LEGACY_DATADIR}" 2>/dev/null || true)" ]; then
    rmdir "${LEGACY_DATADIR}" 2>/dev/null || true
  fi
fi
if [ ! -e "${LEGACY_DATADIR}" ]; then
  ln -s "${DATADIR}" "${LEGACY_DATADIR}" || true
fi

# Erste Initialisierung (jetzt im persistenten Datadir)
if [ ! -d "${DATADIR}/mysql" ] && [ ! -f "${DATADIR}/ibdata1" ]; then
  bashio::log.info "MariaDB erste Initialisierung in ${DATADIR} ..."
  mysqld --initialize-insecure --user=mysql --datadir="${DATADIR}"
  chown -R mysql:mysql "${DATADIR}"
fi

bashio::log.info "MariaDB Pre-Start abgeschlossen"

exec /usr/sbin/mysqld \
  --user=mysql \
  --datadir="${DATADIR}" \
  --skip-networking
